# Copy to .env and adjust. Every value below is the default, so an empty .env works too.

# --- Ollama (runs on the host, used for both generation and embeddings) ---
# When the API runs inside Docker, point this at the host instead:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Generation model. A roughly 4-billion-parameter instruction model at 4-bit
# quantisation is the default so the whole stack stays within a few gigabytes
# of memory and answers at a readable speed without a GPU. See eval/results.md
# for the comparison this default comes from.
GENERATION_MODEL=gemma3:4b

# Embedding model. bge-m3 is multilingual, which is what makes an Arabic
# question able to retrieve an English passage and the other way round.
EMBEDDING_MODEL=bge-m3

# --- Retrieval and generation budget ---
# Number of chunks placed in the prompt. Three was measured and reverted: a
# question is often answered by two sections of one service, and the fourth
# passage is what carries the second one.
TOP_K=4
# Context window handed to the generation model.
NUM_CTX=4096
# Upper bound on answer length, in tokens.
MAX_ANSWER_TOKENS=512
# How long Ollama keeps the models resident between requests.
KEEP_ALIVE=30m
# Warm the models when the API starts. Warming runs in the background, so the
# port accepts connections at once and /api/health reports "warming" until the
# generation model is loaded.
WARM_MODEL_ON_STARTUP=true

# Longest passage placed in the prompt, in characters. Unset means the whole
# passage. Capping it shortens the prompt, which is most of the time to first
# token, but a 500-character cap measurably cost key-fact recall: the tail of a
# fee or document list is sometimes the part the question was about.
# MAX_PASSAGE_CHARS=

# Generation threads. Unset lets Ollama choose. The fastest setting measured was
# the number of physical cores, which is worth setting explicitly if you know
# it: see the latency table in eval/results.md.
# NUM_THREAD=

# --- Request timeouts, in seconds ---
EMBEDDING_TIMEOUT=120
GENERATION_TIMEOUT=300

# --- Paths ---
DATA_DIR=data
INDEX_DIR=data/index

# --- Privacy ---
# Question text is never written to logs unless this is turned on deliberately.
LOG_QUESTIONS=false

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
